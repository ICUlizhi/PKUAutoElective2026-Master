# Node profile for cloned machine
# Copy to: /home/ubuntu/work/skj/node_profile.env

# Tencent Cloud region, e.g. ap-beijing
REGION=ap-beijing

# NAT and subnet used by this node
NAT_ID=nat-xxxxxxxx
SUBNET_ID=subnet-xxxxxxxx

# 10 EIPs (ID list, comma-separated) under this NAT
EIPS=eip-aaaa,eip-bbbb,eip-cccc,eip-dddd,eip-eeee,eip-ffff,eip-gggg,eip-hhhh,eip-iiii,eip-jjjj

# Optional overrides
STATE_FILE=/home/ubuntu/work/skj/.rotate_snat_state.node.json
LOOP_MODE=normal
ROTATE_ON_LOOP_END=1
